# Large published artifacts archived from the CMS TWiki are stored in Git LFS.
# Small text artifacts (.ucf, .csv, .txt, .cpj) stay as ordinary Git objects so
# they remain diffable and viewable on GitHub.
assets/*.gz   filter=lfs diff=lfs merge=lfs -text
assets/*.zip  filter=lfs diff=lfs merge=lfs -text
assets/*.pdf  filter=lfs diff=lfs merge=lfs -text
assets/*.docx filter=lfs diff=lfs merge=lfs -text
assets/*.png  filter=lfs diff=lfs merge=lfs -text
assets/*.jpg  filter=lfs diff=lfs merge=lfs -text
assets/*.bit  filter=lfs diff=lfs merge=lfs -text
